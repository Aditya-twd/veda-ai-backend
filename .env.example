# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000        # frontend origin (CORS + socket.io)

# ─── Database (configure later — server boots without these) ───
# Local Docker:  mongodb://localhost:27017/vedaai
MONGODB_URI=

# ─── Redis (needed for BullMQ + caching) ───
# Local Docker:  redis://localhost:6379
REDIS_URL=

# ─── Gemini (provide your key later) ───
GEMINI_API_KEY=
# Use a free-tier-enabled model (gemini-2.0-flash is paid-tier only).
GEMINI_MODEL=gemini-2.5-flash

# ─── Uploads ───
MAX_UPLOAD_MB=10

# ─── Auth ───
# Google OAuth Client ID (Web application) from Google Cloud Console — see README.
# Must be the SAME value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Secret used to sign our JWTs. Use any long random string (required in production).
JWT_SECRET=
JWT_EXPIRES_IN=7d
